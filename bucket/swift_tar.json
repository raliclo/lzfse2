{
    "version": "0.1.0",
    "description": "Multi-core tar archiver: gzip, bzip2, xz, zstd, lz4, ZIP/ZIP64, encryption (public build, no LZFSE)",
    "homepage": "https://github.com/raliclo/swift_tar",
    "license": "GPL-3.0-only",
    "notes": [
        "Installed as swift_tar.exe. Verify with:  swift_tar --version",
        "The archive carries the Swift runtime DLLs it was built with, so no Swift install is needed.",
        "gzip, zstd, ZIP/ZIP64 and plain tar are linked in; bzip2, xz, lz4 and lzip use the Scoop",
        "CLI tools listed in depends.",
        "url, hash and extract_dir are written by swift_tar's publish.zsh from the archive it",
        "published, never by hand."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/raliclo/swift_tar/releases/download/v0.1.0/swift_tar-0.1.0-windows-x86_64.tar.zst",
            "hash": "b5ba0151253247b172410d53b64eb386861f2cbb6e819ed3fda48fcb33bb2426",
            "extract_dir": "swift_tar-0.1.0-windows-x86_64"
        }
    },
    "bin": "swift_tar.exe",
    "depends": [
        "bzip2",
        "xz",
        "lz4",
        "lzip"
    ],
    "checkver": {
        "github": "https://github.com/raliclo/swift_tar"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/raliclo/swift_tar/releases/download/v$version/swift_tar-$version-windows-x86_64.tar.zst",
                "extract_dir": "swift_tar-$version-windows-x86_64"
            }
        },
        "hash": {
            "url": "$url.sha256"
        }
    }
}
